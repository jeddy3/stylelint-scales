{
  "name": "stylelint-scales",
  "description": "A Stylelint plugin pack to enforce numeric scales",
  "version": "6.0.0",
  "license": "MIT",
  "exports": "./lib/index.js",
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "!lib/testUtils/**",
    "CHANGELOG.md"
  ],
  "type": "module",
  "repository": "jeddy3/stylelint-scales",
  "keywords": [
    "stylelint",
    "stylelint-plugin",
    "spacing",
    "scales",
    "linting",
    "linter",
    "design-system",
    "type-scale"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm-run-all --parallel check:*",
    "check:js": "eslint \"**/*.js\"",
    "check:formating": "prettier \"**/*.{js,md,yml}\" --check",
    "fix": "npm-run-all --sequential fix:*",
    "fix:js": "eslint \"**/*.js\" --fix",
    "fix:formating": "prettier \"**/*.{js,md,yml}\" --write"
  },
  "dependencies": {
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-test-rule-node": "^2.0.0"
  }
}
